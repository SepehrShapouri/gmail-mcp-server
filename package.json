{
  "name": "gmail-mcp-http-server",
  "version": "2.0.0",
  "description": "Gmail MCP HTTP server for multi-tenant SaaS applications",
  "type": "module",
  "main": "dist/http-server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http-server.js",
    "dev": "npx tsx src/http-server.ts",
    "test": "npx tsx test-http-server.ts",
    "prepare": "npm run build"
