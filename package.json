    "express": "^4.21.0",
    "google-auth-library": "^9.4.1",
    "googleapis": "^129.0.0",
    "mime-types": "^3.0.1",
    "nodemailer": "^7.0.3",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.3.3"
